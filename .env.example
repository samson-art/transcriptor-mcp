# Server configuration (REST API)
PORT=3000
HOST=0.0.0.0

# MCP server over Streamable HTTP (npm run start:mcp:http; POST /mcp)
# Not used by the stdio MCP server (npm run start:mcp).
# This process does not authenticate requests — terminate auth at a gateway in front of it.
MCP_PORT=4200
MCP_HOST=0.0.0.0

# yt-dlp timeout (in milliseconds). get_playlist_transcripts does not use it: a playlist call has 90 s from its start, queue wait included. Its run does not start with less than 10 s left, so it waits for a slot for 80 s at most.
YT_DLP_TIMEOUT=60000
# Budget for a whole get_video_frame call, queue wait included (default: YT_DLP_TIMEOUT; 0 = no limit)
# With 0, a stalled stream lookup holds every call that waits on it, and new calls join it for up to 5 minutes.
# YT_DLP_FRAME_TIMEOUT=60000

# Child processes (yt-dlp and ffmpeg share one cap). Above the cap calls wait;
# above the queue they get 503 "server busy" at once. 0 disables the limit.
# A call peaks at ~40 MiB, so this bounds platform throttling and queue latency
# rather than memory: raise it on a box with spare cores, lower it if the
# yt_dlp_reason="bot_check" label starts showing up.
# Worst wait for a queued call = ceil(QUEUE / CONCURRENCY) x YT_DLP_TIMEOUT.
# get_playlist_transcripts leaves the queue with 502 "timeout" after 80 s.
# YT_DLP_MAX_CONCURRENCY=4
# YT_DLP_MAX_QUEUE=8
# For 5-hour videos at ~420 KiB/s: YT_DLP_AUDIO_TIMEOUT=900000, WHISPER_TIMEOUT=3600000
# Whisper API max 25 MB; use local Whisper for long videos
# YT_DLP_AUDIO_TIMEOUT=900000

# Audio for Whisper: format (default bestaudio[abr<=192]/bestaudio/best*[acodec!=none]/best; best*[acodec!=none] is for platforms with no audio-only format, such as TikTok; the last best is for formats with no codec fields, such as Facebook), quality 0-9 (default 5)
# YT_DLP_AUDIO_FORMAT=bestaudio[abr<=192]/bestaudio/best*[acodec!=none]/best
# YT_DLP_AUDIO_QUALITY=5

# JS runtimes for YouTube's player challenges (--js-runtimes). Unset = yt-dlp's own default;
# the Docker image sets deno,node.
# YT_DLP_JS_RUNTIMES=deno,node
# --remote-components for the challenge solver (default ejs:github; empty falls back to it)
# YT_DLP_REMOTE_COMPONENTS=ejs:github
# 1 = pass --no-warnings to every yt-dlp call except metadata runs (default: off).
# Keep it off. Metadata runs always keep the warnings, because the server reads them to find a private,
# removed or bot-checked video. Other runs also use them to classify a failure: a 429 that yt-dlp only warned
# about then reads as a timeout, and the caption hold does not start.
# YT_DLP_NO_WARNINGS=1
# 0 = drop --ignore-no-formats-error from metadata runs (info, chapters, subtitle lists).
# Default on, so region-locked videos still return metadata.
# YT_DLP_IGNORE_NO_FORMATS=1

# yt-dlp retries (all calls) and extra args
# YT_DLP_RETRIES=10
# YT_DLP_RETRY_SLEEP=linear=1::2
# YT_DLP_EXTRA_ARGS=--no-check-certificate

# Sleep options to reduce rate limits (seconds)
# YT_DLP_SLEEP_REQUESTS=1
# YT_DLP_SLEEP_INTERVAL=2
# YT_DLP_MAX_SLEEP_INTERVAL=10
# YT_DLP_SLEEP_SUBTITLES=1

# Subtitle format (srt, vtt, ass, lrc) and encoding
# YT_DLP_SUB_FORMAT=srt
# YT_DLP_ENCODING=utf-8

# First wait after a platform answers 429 to a subtitle download: it keeps answering 429 for
# hours, and asking again spends the quota that keeps the limit on. Each repeat doubles the
# wait, up to an hour. Metadata is never held back. 0 turns the hold off, and the strike
# count (`subtitle_rate_limit_strikes`) with it.
# SUBTITLES_RATE_LIMIT_HOLD_MS=600000

# Audio download options (Whisper fallback only; DASH/HLS)
# YT_DLP_AUDIO_CONCURRENT_FRAGMENTS=4
# YT_DLP_AUDIO_LIMIT_RATE=4M
# YT_DLP_AUDIO_THROTTLED_RATE=100K
# YT_DLP_AUDIO_RETRIES=15
# YT_DLP_AUDIO_FRAGMENT_RETRIES=20
# YT_DLP_AUDIO_RETRY_SLEEP=exp=1:20
# YT_DLP_AUDIO_BUFFER_SIZE=64K
# YT_DLP_AUDIO_HTTP_CHUNK_SIZE=10M
# YT_DLP_AUDIO_DOWNLOADER=aria2c
# YT_DLP_AUDIO_DOWNLOADER_ARGS=aria2c:"-x 4 -k 1M"

# Path to cookies file in Netscape format (optional)
COOKIES_FILE_PATH=/path/to/cookies.txt

# Proxy for yt-dlp (optional; http, https, or socks5)
# YT_DLP_PROXY=http://user:password@proxy.example.com:8080
# YT_DLP_PROXY=socks5://127.0.0.1:9050

# Rate limiting
RATE_LIMIT_MAX=100
# A number of milliseconds or a duration such as 1 minute or 30s. Do not put it in quotes:
# docker run --env-file keeps them. The REST API does not start with a value it cannot read,
# or with a value below 1 millisecond.
# GET /metrics has its own limit of 60 requests a minute for each address.
RATE_LIMIT_TIME_WINDOW=1 minute
# For load testing, raise RATE_LIMIT_MAX (e.g. 1000) so limits don't cap throughput

# CORS (optional: comma-separated origins; if unset, all origins allowed)
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Graceful shutdown timeout (in milliseconds)
SHUTDOWN_TIMEOUT=10000

# Whisper fallback (when YouTube subtitles are not available)
# WHISPER_MODE=off          # off (default), local, api
# Example local (e.g. Docker service named "whisper" on port 9000):
#   WHISPER_MODE=local
#   WHISPER_BASE_URL=http://whisper:9000
#   WHISPER_TIMEOUT=600000   # how long the API waits per request before 404 (default 10 min)
#   WHISPER_BACKGROUND_TIMEOUT=   # unset = max(30m, 3×WHISPER_TIMEOUT); 0 = no HTTP abort on background job
# WHISPER_MAX_DURATION_SECONDS=   # unset or 0 = no limit; e.g. 120 skips Whisper for longer videos and live streams (a video of unreported length is measured with ffprobe after the audio download)
# Example API (OpenAI or compatible):
#   WHISPER_MODE=api
#   WHISPER_API_KEY=sk-...
#   WHISPER_API_BASE_URL=https://api.openai.com/v1

# Cache (Redis only; when CACHE_MODE=redis, CACHE_REDIS_URL is required)
# CACHE_MODE=off              # off (default), redis
# CACHE_TTL_SUBTITLES_SECONDS=604800   # 7 days for successfully fetched subtitles
# CACHE_TTL_METADATA_SECONDS=3600      # 1 hour for video info, available subtitles, chapters, and a track that brought no text
# CACHE_REDIS_URL=redis://localhost:6379

# Logging
# LOG_LEVEL=info

# Error monitoring (Sentry Cloud). If SENTRY_DSN is unset, no events are sent.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=          # Defaults to the package version; set to a git sha for finer release tracking
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_SEND_DEFAULT_PII=false
# Off when unset. Behind a gateway that sends x-mcpal-user-id, each tool call sends one Sentry
# log with an HMAC of that id as the user id. Sentry then counts the users who meet errors.
# The log fields are in docs/adr/008. Use a long random value, the same on every instance,
# for example from `openssl rand -hex 32`. Describe the log in your privacy policy first.
# SENTRY_USER_HASH_SECRET=

# Canary (MCP over HTTP only): fetches one transcript on a schedule so a silent
# block by the video platform shows up as a metric and one alert. 0 disables it.
# CANARY_INTERVAL_MS=900000
# CANARY_URL=https://www.youtube.com/watch?v=jNQXAC9IVRw

# yt-dlp startup (optional)
# YT_DLP_SKIP_VERSION_CHECK=1
# YT_DLP_REQUIRED=0

# yt-dlp filters (optional)
# YT_DLP_MAX_FILESIZE=50M          # for Whisper audio; abort if larger
# YT_DLP_DOWNLOAD_ARCHIVE=/path    # for get_playlist_transcripts; skip archived videos
# YT_DLP_PLAYLIST_IGNORE_ERRORS=0  # default: unset = pass --ignore-errors on playlist subs; set 0 to disable
# YT_DLP_VERBOSE_ON_ERROR=1        # after a failed playlist subtitle run with no files, replay yt-dlp with -v and without --quiet (logs only). The replay uses what is left of the 90 s of the call. It does not start during a caption hold, with less than 10 s left, or after the 90 s stopped the main run
# YT_DLP_AGE_LIMIT=18              # for search_videos; filter by age rating
