{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/samson-art/transcriptor-mcp#mcp-config",
  "title": "Transcriptor MCP configuration",
  "description": "Session configuration for the Transcriptor MCP server. For Smithery installs, paste your token issued via Google Form into apiToken; the gateway forwards it as X-MCP-Api-Token for your edge to validate and rate-limit /mcp (and /sse).",
  "type": "object",
  "properties": {
    "apiToken": {
      "type": "string",
      "title": "API token (Smithery)",
      "description": "Token issued by maintainer via Google Form access flow. User sets this value in session config; Smithery forwards it as X-MCP-Api-Token so your reverse proxy or WAF can reject missing/invalid tokens and apply per-token or per-IP quotas on MCP HTTP traffic. Stored only in your client; never commit or log.",
      "secret": true,
      "x-from": { "header": "x-mcp-api-token" },
      "x-to": { "header": "x-mcp-api-token" }
    }
  },
  "required": [],
  "additionalProperties": false,
  "documentation": {
    "gettingStarted": {
      "title": "Getting started",
      "description": "1. If you connect through Smithery (https://server.smithery.ai/samson-art/transcriptor-mcp), request access via https://forms.gle/gFUb5X6mTmzNaHUu6 and paste the issued token into apiToken in session config so the gateway sends X-MCP-Api-Token.\n2. Configure your edge to require X-MCP-Api-Token and apply rate limits on /mcp (and /sse).\n3. Use get_transcript, get_video_info, or search_videos to fetch transcripts and metadata."
    },
    "apiLink": "https://github.com/samson-art/transcriptor-mcp#readme",
    "security": "Treat apiToken as a secret. Do not commit it, paste it into public chats, or log request headers. Quotas for MCP over HTTP belong on your infrastructure (edge before mcp-proxy), typically keyed by X-MCP-Api-Token."
  }
}
