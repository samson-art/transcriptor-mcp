  {
    "name": "get_video_frame",
    "title": "Get video frame",
    "description": "Capture a single frame from a video at the given timestamp. Provide timecode (\"01:23\", \"00:01:23.500\") or seconds; defaults to the first frame. Optional: format (png|jpeg), width (max 1920), quality (jpeg, 2-31). Returns the image plus metadata.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Video URL (supported: YouTube, Twitter/X, Instagram, TikTok, Twitch, Vimeo, Facebook, Bilibili, VK, Dailymotion, Reddit) or YouTube video ID"
        },
        "timecode": {
          "description": "Timestamp as \"MM:SS\" or \"HH:MM:SS(.mmm)\", e.g. \"01:23\" or \"00:01:23.500\"",
          "type": "string"
        },
        "seconds": {
          "description": "Timestamp in seconds (alternative to timecode). Default: 0 (first frame)",
          "type": "number",
          "minimum": 0
        },
        "format": {
          "description": "Image format (default: jpeg)",
          "type": "string",
          "enum": [
            "png",
            "jpeg"
          ]
        },
        "width": {
          "description": "Output image width in pixels (default: 1280, max: 1920). Never upscales.",
          "type": "integer",
          "minimum": 64,
          "maximum": 1920
        },
        "quality": {
          "description": "JPEG quality (ffmpeg -q:v): 2 (best) to 31 (worst). Default: 4. Ignored for png.",
          "type": "integer",
          "minimum": 2,
          "maximum": 31
        }
      },
      "required": [
        "url"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": true,
      "destructiveHint": false
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://get-video-frame/app.html"
      },
      "openai/outputTemplate": "ui://get-video-frame/app.html",
      "openai/toolInvocation/invoking": "Capturing frame…",
      "openai/toolInvocation/invoked": "Frame captured"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "videoId": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "timestampSeconds": {
          "type": "number"
        },
        "timestamp": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "number"
        },
        "width": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "videoId",
        "timestampSeconds",
        "timestamp",
        "mimeType",
        "sizeBytes",
        "width"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "get_playlist_transcripts",
    "title": "Get playlist transcripts",
    "description": "Fetch cleaned subtitles (plain text) for multiple videos from a playlist. Use playlistItems (e.g. \"1:5\") to select specific items, maxItems to limit count.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Playlist URL (e.g. youtube.com/playlist?list=XXX) or watch URL with list= parameter"
        },
        "type": {
          "description": "Subtitle track type: official or auto-generated (default: auto)",
          "type": "string",
          "enum": [
            "official",
            "auto"
          ]
        },
        "lang": {
          "description": "Language code (e.g. en, ru). Required: the original language is picked only for one video at a time (get_transcript)",
          "type": "string"
        },
        "format": {
          "description": "Subtitle format (default from YT_DLP_SUB_FORMAT or srt)",
          "type": "string",
          "enum": [
            "srt",
            "vtt",
            "ass",
            "lrc"
          ]
        },
        "playlistItems": {
          "description": "yt-dlp -I spec: \"1:5\", \"1,3,7\", \"-1\" for last, \"1:10:2\" for every 2nd",
          "type": "string"
        },
        "maxItems": {
          "default": 10,
          "description": "Max number of videos to fetch: 1 to 20 (default 10)",
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "url"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": true,
      "destructiveHint": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "videoId": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "videoId",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "results"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "search_videos",
    "title": "Search videos",
    "description": "Search videos on YouTube via yt-dlp (ytsearch). Returns list of matching videos with metadata. Optional: limit, offset (pagination), uploadDateFilter (hour|today|week|month|year), dateBefore, date, matchFilter (e.g. \"!is_live\"), response_format (json|markdown).",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "query": {
          "description": "Search query",
          "type": "string"
        },
        "limit": {
          "description": "Max results (default 10)",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "offset": {
          "description": "Skip first N results (pagination)",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uploadDateFilter": {
          "description": "Filter by upload date (relative to now)",
          "type": "string",
          "enum": [
            "hour",
            "today",
            "week",
            "month",
            "year"
          ]
        },
        "dateBefore": {
          "description": "yt-dlp --datebefore, e.g. \"now-1year\" or \"20241201\"",
          "type": "string"
        },
        "date": {
          "description": "yt-dlp --date, exact date e.g. \"20231215\" or \"today-2weeks\"",
          "type": "string"
        },
        "matchFilter": {
          "description": "yt-dlp --match-filter, e.g. \"!is_live\" or \"duration < 3600 & like_count > 100\"",
          "type": "string"
        },
        "response_format": {
          "description": "Format of the human-readable content: json (default) or markdown",
          "type": "string",
          "enum": [
            "json",
            "markdown"
          ]
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": false,
      "openWorldHint": true,
      "destructiveHint": false
    },
    "_meta": {
      "ui": {
        "resourceUri": "ui://search-videos/app.html"
      },
      "openai/outputTemplate": "ui://search-videos/app.html",
      "openai/toolInvocation/invoking": "Searching videos…",
      "openai/toolInvocation/invoked": "Videos found"
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "videoId": {
                "type": "string"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "duration": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "uploader": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "viewCount": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "thumbnail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "videoId",
              "title",
              "url",
              "duration",
              "uploader",
              "viewCount",
              "thumbnail"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "results"
      ],
      "additionalProperties": false
    }
  }
