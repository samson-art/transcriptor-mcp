    {
      "name": "get_video_frame",
      "title": "Get video frame",
      "description": "Capture a single frame from a video at the given timestamp. Provide timecode (\"01:23\", \"00:01:23.500\") or seconds; defaults to the first frame. Optional: format (png|jpeg), width (max 1920), quality (jpeg, 2-31). Returns the image plus metadata.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Video URL (supported: YouTube, Twitter/X, Instagram, TikTok, Twitch, Vimeo, Facebook, Bilibili, VK, Dailymotion, Reddit) or YouTube video ID"
          },
          "timecode": {
            "type": "string",
            "description": "Timestamp as \"MM:SS\" or \"HH:MM:SS(.mmm)\", e.g. \"01:23\" or \"00:01:23.500\""
          },
          "seconds": {
            "type": "number",
            "minimum": 0,
            "description": "Timestamp in seconds (alternative to timecode). Default: 0 (first frame)"
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "jpeg"
            ],
            "description": "Image format (default: jpeg)"
          },
          "width": {
            "type": "integer",
            "minimum": 64,
            "maximum": 1920,
            "description": "Output image width in pixels (default: 1280, max: 1920). Never upscales."
          },
          "quality": {
            "type": "integer",
            "minimum": 2,
            "maximum": 31,
            "description": "JPEG quality (ffmpeg -q:v): 2 (best) to 31 (worst). Default: 4. Ignored for png."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
