{
  "tools": [
    {
      "name": "get_transcript",
      "title": "Get video transcript",
      "description": "Fetch cleaned subtitles as plain text for a video (YouTube, Twitter/X, Instagram, TikTok, Twitch, Vimeo, Facebook, Bilibili, VK, Dailymotion, Reddit). Without lang, returns the video's original language, or the list of tracks when the server cannot tell which one that is. Optional: type, lang, response_limit (when omitted returns full transcript), next_cursor for pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Video URL (supported: YouTube, Twitter/X, Instagram, TikTok, Twitch, Vimeo, Facebook, Bilibili, VK, Dailymotion, Reddit) or YouTube video ID"
          },
          "format": {
            "type": "string",
            "enum": [
              "srt",
              "vtt",
              "ass",
              "lrc"
            ],
            "description": "Subtitle format (default from YT_DLP_SUB_FORMAT or srt)"
          },
          "type": {
            "type": "string",
            "enum": [
              "official",
              "auto"
            ],
            "description": "Subtitle track type: official or auto-generated. Without lang, the server picks a track of this type"
          },
          "lang": {
            "type": "string",
            "description": "Language code or track name as get_available_subtitles lists it (e.g. en, es, en_US). Omit to get the video's original language; when the server cannot tell which track that is, it answers with the list of tracks"
          },
          "response_limit": {
            "type": "integer",
            "minimum": 1000,
            "description": "Max characters per response. When omitted, returns full content. When set: min 1000"
          },
          "next_cursor": {
            "type": "string",
            "description": "Opaque cursor from previous response for pagination"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": true,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "ui": {
          "resourceUri": "ui://get-transcript/app.html"
        },
        "openai/outputTemplate": "ui://get-transcript/app.html",
        "openai/toolInvocation/invoking": "Fetching transcript…",
        "openai/toolInvocation/invoked": "Transcript ready"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "official",
              "auto"
            ]
          },
          "lang": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "next_cursor": {
            "type": "string"
          },
          "is_truncated": {
            "type": "boolean"
          },
          "total_length": {
            "type": "number"
          },
          "start_offset": {
            "type": "number"
          },
          "end_offset": {
            "type": "number"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "videoId",
          "type",
          "lang",
          "text",
          "is_truncated",
          "total_length",
          "start_offset",
          "end_offset"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
