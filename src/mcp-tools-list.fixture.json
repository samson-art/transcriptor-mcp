    {
      "name": "get_playlist_transcripts",
      "title": "Get playlist transcripts",
      "description": "Fetch cleaned subtitles (plain text) for multiple videos from a playlist. Use playlistItems (e.g. \"1:5\") to select specific items, maxItems to limit count.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Playlist URL (e.g. youtube.com/playlist?list=XXX) or watch URL with list= parameter"
          },
          "type": {
            "type": "string",
            "enum": [
              "official",
              "auto"
            ],
            "description": "Subtitle track type: official or auto-generated (default: auto)"
          },
          "lang": {
            "type": "string",
            "description": "Language code (e.g. en, ru). Required: the original language is picked only for one video at a time (get_transcript)"
          },
          "format": {
            "type": "string",
            "enum": [
              "srt",
              "vtt",
              "ass",
              "lrc"
            ],
            "description": "Subtitle format (default from YT_DLP_SUB_FORMAT or srt)"
          },
          "playlistItems": {
            "type": "string",
            "description": "yt-dlp -I spec: \"1:5\", \"1,3,7\", \"-1\" for last, \"1:10:2\" for every 2nd"
          },
          "maxItems": {
            "type": "integer",
            "minimum": 1,
            "description": "Max number of videos to fetch (yt-dlp --max-downloads)"
          }
        },
        "required": [
          "url"
